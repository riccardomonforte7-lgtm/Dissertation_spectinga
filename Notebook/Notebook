# Create diagnostic summaries for quantitative variables
create_numeric_diagnostics <- function(data, variables) {

  bind_rows(
    lapply(
      variables,
      function(variable) {

        x <- data[[variable]]

        q1 <- quantile(
          x,
          0.25,
          na.rm = TRUE,
          names = FALSE
        )

        q3 <- quantile(
          x,
          0.75,
          na.rm = TRUE,
          names = FALSE
        )

        variable_iqr <- q3 - q1

        lower_bound <- q1 - 1.5 * variable_iqr
        upper_bound <- q3 + 1.5 * variable_iqr

        tibble(
          variable = variable,
          observations = sum(!is.na(x)),
          missing_values = sum(is.na(x)),
          negative_values = sum(x < 0, na.rm = TRUE),
          zero_values = sum(x == 0, na.rm = TRUE),
          minimum = min(x, na.rm = TRUE),
          percentile_1 = quantile(
            x,
            0.01,
            na.rm = TRUE,
            names = FALSE
          ),
          percentile_25 = q1,
          median = median(
            x,
            na.rm = TRUE
          ),
          mean = mean(
            x,
            na.rm = TRUE
          ),
          percentile_75 = q3,
          percentile_99 = quantile(
            x,
            0.99,
            na.rm = TRUE,
            names = FALSE
          ),
          maximum = max(x, na.rm = TRUE),
          lower_iqr_bound = lower_bound,
          upper_iqr_bound = upper_bound,
          iqr_outliers = sum(
            x < lower_bound |
              x > upper_bound,
            na.rm = TRUE
          )
        )
      }
    )
  )
}

