```{r}
# Split an analytical dataset chronologically
# while keeping all observations from the same date together
temporal_train_test_split <- function(
    data,
    test_fraction = 0.20
) {

  # Check that the date variable is correctly formatted
  if (!inherits(data$observed_date, "Date")) {
    stop("observed_date must be stored as a Date variable.")
  }

  # Order observations chronologically
  data <- data[
    order(
      data$observed_date,
      data$market_id
    ),
  ]

  rownames(data) <- NULL

  # Count observations for each date
  daily_counts <- table(
    data$observed_date
  )

  dates <- as.Date(
    names(daily_counts)
  )

  daily_counts <- as.integer(
    daily_counts
  )

  # Calculate the number of observations from
  # each candidate cutoff date to the final date
  observations_from_date <- rev(
    cumsum(
      rev(daily_counts)
    )
  )

  # Define the target number of test observations
  target_test_observations <- nrow(data) *
    test_fraction

  # Select the cutoff date giving the closest
  # possible test proportion without splitting dates
  cutoff_position <- which.min(
    abs(
      observations_from_date -
        target_test_observations
    )
  )

  cutoff_date <- dates[
    cutoff_position
  ]

  # Create training and test samples
  train_data <- data[
    data$observed_date < cutoff_date,
  ]

  test_data <- data[
    data$observed_date >= cutoff_date,
  ]

  rownames(train_data) <- NULL
  rownames(test_data) <- NULL

  # Return datasets and split information
  list(
    train = train_data,
    test = test_data,
    cutoff_date = cutoff_date,
    target_test_fraction = test_fraction,
    actual_test_fraction = nrow(test_data) /
      nrow(data)
  )
}
