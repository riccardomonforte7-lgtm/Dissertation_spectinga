select_effects_for_plot <- function(effect_data, max_levels = 15) {
  
  n_levels <- nrow(effect_data)
  
  # If the number of levels is small enough, show all
  if (n_levels <= max_levels) {
    
    effect_data <- effect_data[
      order(effect_data$mean),
    ]
    
    return(effect_data)
  }
  
  # Otherwise, keep only the most relevant levels
  effect_data$abs_mean <- abs(effect_data$mean)
  
  effect_data <- effect_data[
    order(effect_data$abs_mean, decreasing = TRUE),
  ]
  
  effect_data <- head(effect_data, max_levels)
  
  effect_data <- effect_data[
    order(effect_data$mean),
  ]
  
  effect_data
}
```

