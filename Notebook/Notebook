value_count <- function(x) {

  if (is.factor(x)) {
    values <- factor(levels(x), levels = levels(x))
    n <- tabulate(as.integer(x), nbins = length(levels(x)))

    if (anyNA(x)) {
      values <- c(values, factor(NA, levels = levels(x)))
      n <- c(n, sum(is.na(x)))
    }

  } else {
    values <- unique(x)

    n <- vapply(seq_along(values), function(i) {
      if (is.na(values[i])) {
        sum(is.na(x))
      } else {
        sum(x == values[i], na.rm = TRUE)
      }
    }, integer(1))
  }

  order_n <- order(n, decreasing = TRUE)

  data.frame(
    value = values[order_n],
    n = n[order_n],
    percentage = round(100 * n[order_n] / sum(n), 3),
    row.names = NULL
  )
}

