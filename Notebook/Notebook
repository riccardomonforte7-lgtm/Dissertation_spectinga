 ```{r}
 #------------------------------------------------------------
# Evaluation of the joint model
#------------------------------------------------------------

evaluate_joint_inla_model <- function(
  model,
  joint_data,
  model_name = "Model 4"
) {

  predicted <- model$summary.fitted.values$mean

  if (length(predicted) != nrow(joint_data)) {
    stop(
      "The number of predictions does not match ",
      "the number of observations."
    )
  }

  calculate_metrics <- function(
    observed,
    predicted
  ) {

    residuals <- observed - predicted

    sse <- sum(
      residuals^2
    )

    tss <- sum(
      (observed - mean(observed))^2
    )

    data.frame(
      N = length(observed),
      R2 = 1 - sse / tss,
      RMSE_model_scale = sqrt(
        mean(residuals^2)
      ),
      MAE_model_scale = mean(
        abs(residuals)
      )
    )
  }

  groups <- list(
    Sold_train =
      joint_data$outcome == "sold" &
      joint_data$sample == "train",

    Sold_test =
      joint_data$outcome == "sold" &
      joint_data$sample == "test",

    Ask_train =
      joint_data$outcome == "ask" &
      joint_data$sample == "train",

    Ask_test =
      joint_data$outcome == "ask" &
      joint_data$sample == "test"
  )

  results <- do.call(
    rbind,
    lapply(
      names(groups),
      function(group_name) {

        index <- groups[[group_name]]

        group_results <- calculate_metrics(
          observed = log(
            joint_data$price_value[index]
          ),
          predicted = predicted[index]
        )

        cbind(
          Model = model_name,
          Dataset = group_name,
          group_results
        )
      }
    )
  )

  rownames(results) <- NULL

  results
}
