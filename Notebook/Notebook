##GPS variable
# Clean and standardise the GPS variable by combining equivalent
# descriptions into a smaller set of substantively meaningful categories.
# Missing values are retained as "Not reported" because the absence of
# GPS information does not necessarily imply that GPS equipment is absent.

market_data_clean <- market_data_clean %>%
  mutate(
    # Preserve the original GPS value for auditing and comparison
    gps_original = gps,

    # Standardise capitalisation and unnecessary whitespace
    gps_clean = gps %>%
      str_to_lower() %>%
      str_squish(),

    # Group equivalent GPS descriptions into common categories
    gps_grouped = case_when(
      # Retain missing GPS information as a separate category
      is.na(gps_clean) ~ "Not reported",

      # Combine RTK-related descriptions
      gps_clean %in% c(
        "rtk",
        "rtk gps"
      ) ~ "RTK",

      # Retain automatic steering as a separate functional category
      gps_clean == "auto steering" ~ "Auto steering",

      # Combine descriptions indicating that a GPS receiver is installed
      gps_clean %in% c(
        "gps receiver",
        "receiver"
      ) ~ "GPS receiver",

      # Combine descriptions indicating that the machine is GPS-ready
      gps_clean %in% c(
        "ready",
        "gps ready"
      ) ~ "GPS ready",

      # Combine affirmative but technologically unspecified responses
      gps_clean %in% c(
        "yes",
        "ja"
      ) ~ "GPS present",

      # Retain any unexpected descriptions for subsequent inspection
      TRUE ~ "Other / unclassified"
    )
  )

  # Inspect the distribution of the grouped GPS variable
gps_values_clean <- market_data_clean %>%
  count(
    gps_grouped,
    name = "n",
    sort = TRUE
  ) %>%
  mutate(
    percentage = round(
      100 * n / sum(n),
      3
    )
  )

