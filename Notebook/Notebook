# Create one conditional-mean table for each variable
conditional_means_list <- lapply(
  conditional_variables,
  function(variable) {

    # Convert every grouping variable to character
    # so that TRUE and FALSE are preserved correctly
    temporary_data <- data.frame(
      level = as.character(
        market_data_sold_train[[variable]]
      ),
      price_sold = market_data_sold_train$price_sold,
      horsepower = market_data_sold_train$horsepower
    )

    # Calculate conditional means by level
    output <- aggregate(
      cbind(
        price_sold,
        horsepower
      ) ~ level,
      data = temporary_data,
      FUN = mean
    )

    # Rename columns
    names(output) <- c(
      "level",
      "mean_price_sold",
      "mean_horsepower"
    )

    # Add the conditioning-variable name
    output$variable <- variable

    # Reorder columns
    output <- output[
      ,
      c(
        "variable",
        "level",
        "mean_price_sold",
        "mean_horsepower"
      )
    ]

    # Sort levels by decreasing average sold price
    output <- output[
      order(
        output$mean_price_sold,
        decreasing = TRUE
      ),
    ]

    rownames(output) <- NULL

    output
  }
)

