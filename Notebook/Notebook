# Count unique values and calculate percentages
value_count <- function(data, variable) {
  x <- data[[variable]]
  counts <- table(x, useNA = "ifany")
  counts <- sort(counts, decreasing = TRUE)

  data.frame(
    value = names(counts),
    n = as.integer(counts),
    percentage = round(100 * as.integer(counts) / sum(counts), 3),
    row.names = NULL
  )
}

categorical_value_tables <- setNames(
  lapply(categorical_vars, function(x) value_count(market_data, x)),
