```{r}
#------------------------------------------------------------
# Model 5: joint posterior sampling
#------------------------------------------------------------

# Number of training and test observations
n_train_m5 <- nrow(
  market_data_sold_train
)

n_test_m5 <- nrow(
  market_data_sold_test
)


# Positions of the test observations in market_data_inla
# Training observations are stored before test observations
test_rows_m5 <-
  n_train_m5 + seq_len(n_test_m5)


# Number of joint posterior samples
n_posterior_samples_m5 <- 5000


# Set the seed for reproducibility
set.seed(123)


# Draw jointly from the approximate posterior distribution
# and retain only the test linear predictors
posterior_samples_m5 <- inla.posterior.sample(
  n = n_posterior_samples_m5,
  result = m5,

  selection = list(
    Predictor = test_rows_m5
  ),

  # Return hyperparameters on their natural scale
  intern = FALSE,

  seed = 123L,
  num.threads = 1
)
```

```{r}
#------------------------------------------------------------
# Extract posterior draws
#------------------------------------------------------------

# Extract the selected test linear predictors
# Rows are test observations and columns are posterior samples
linear_predictor_draws_m5 <- sapply(
  posterior_samples_m5,
  function(sample_m5) {
    as.numeric(
      sample_m5$latent
    )
  }
)


# Extract the residual precision from each posterior sample
# The residual precision is the first hyperparameter in Model 5
residual_precision_draws_m5 <- sapply(
  posterior_samples_m5,
  function(sample_m5) {
    as.numeric(
      sample_m5$hyperpar
    )[1]
  }
)


# Use the degrees of freedom fixed when fitting Model 5
degrees_freedom_m5 <- 7
```

```{r}
#------------------------------------------------------------
# Simulate Student-t observation errors
#------------------------------------------------------------

# Convert each posterior draw of residual precision
# into the corresponding Student-t scale
residual_scale_draws_m5 <- sqrt(
  (degrees_freedom_m5 - 2) /
    (
      degrees_freedom_m5 *
        residual_precision_draws_m5
    )
)


# Set the seed for the observation-level simulations
set.seed(456)


# Draw one standard Student-t error for every
# test observation and posterior sample
standard_t_errors_m5 <- matrix(
  rt(
    n_test_m5 *
      n_posterior_samples_m5,

    df = degrees_freedom_m5
  ),

  nrow = n_test_m5,
  ncol = n_posterior_samples_m5
)


# Apply the residual scale associated with each
# posterior draw of the precision
residual_draws_m5 <- sweep(
  standard_t_errors_m5,
  MARGIN = 2,
  STATS = residual_scale_draws_m5,
  FUN = "*"
)
```

```{r}
#------------------------------------------------------------
# Generate posterior predictive log-prices
#------------------------------------------------------------

# Add observation-level errors to the jointly sampled
# linear predictors
log_price_draws_m5 <-
  linear_predictor_draws_m5 +
  residual_draws_m5
```

