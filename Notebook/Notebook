```{r} 
#------------------------------------------------------------
# Evaluation function for any INLA model
#------------------------------------------------------------

evaluate_inla_model <- function(
  model,
  train_data,
  test_data,
  response_variable = "price_sold",
  response_transformation = log,
  model_name = "Model"
) {

  # Sample sizes
  n_train <- nrow(train_data)
  n_test  <- nrow(test_data)
  n_total <- n_train + n_test

  # Check that fitted values were computed
  if (is.null(model$summary.fitted.values)) {
    stop(
      "Fitted values are unavailable. ",
      "Use control.predictor = list(compute = TRUE, link = 1)."
    )
  }

  # Extract posterior mean fitted values
  predicted_all <- model$summary.fitted.values$mean

  # The model must contain both train and test observations
  if (length(predicted_all) != n_total) {
    stop(
      "The number of fitted values does not equal ",
      "the combined number of train and test observations. ",
      "Fit the model using market_data_inla."
    )
  }

  # Separate train and test predictions
  predicted_train <- predicted_all[
    seq_len(n_train)
  ]

  predicted_test <- predicted_all[
    n_train + seq_len(n_test)
  ]

  # Transform the observed response onto the model scale
  transform_function <- match.fun(
    response_transformation
  )

  observed_train <- transform_function(
    train_data[[response_variable]]
  )

  observed_test <- transform_function(
    test_data[[response_variable]]
  )

  # Check lengths and finite values
  if (length(observed_train) != length(predicted_train)) {
    stop("Train observed and predicted values have different lengths.")
  }

  if (length(observed_test) != length(predicted_test)) {
    stop("Test observed and predicted values have different lengths.")
  }

  if (
    any(!is.finite(observed_train)) ||
    any(!is.finite(observed_test)) ||
    any(!is.finite(predicted_train)) ||
    any(!is.finite(predicted_test))
  ) {
    stop("Observed or predicted values contain non-finite values.")
  }

  # Function for predictive metrics
  calculate_metrics <- function(
    observed,
    predicted
  ) {

    residuals <- observed - predicted

    sse <- sum(
      residuals^2
    )

    tss <- sum(
      (observed - mean(observed))^2
    )

    if (tss <= .Machine$double.eps) {
      stop("The response has no variability.")
    }

    data.frame(
      N = length(observed),

      R2 = 1 - sse / tss,

      RMSE_model_scale = sqrt(
        mean(residuals^2)
      ),

      MAE_model_scale = mean(
        abs(residuals)
      ),

      SSE = sse,
      TSS = tss
    )
  }

  # Train and test metrics
  train_metrics <- calculate_metrics(
    observed_train,
    predicted_train
  )

  test_metrics <- calculate_metrics(
    observed_test,
    predicted_test
  )

  predictive_metrics <- rbind(
    cbind(
      Model = model_name,
      Dataset = "Train",
      train_metrics
    ),

    cbind(
      Model = model_name,
      Dataset = "Test",
      test_metrics
    )
  )

  rownames(predictive_metrics) <- NULL

  # Safely extract DIC and WAIC
  dic_value <- if (
    is.null(model$dic$dic)
  ) {
    NA_real_
  } else {
    model$dic$dic
  }

  waic_value <- if (
    is.null(model$waic$waic)
  ) {
    NA_real_
  } else {
    model$waic$waic
  }

  # Calculate NLSCPO using training observations only
  if (is.null(model$cpo$cpo)) {

    nlscpo_value <- NA_real_
    mean_nlscpo_value <- NA_real_
    invalid_cpo <- NA_integer_

  } else {

    cpo_train <- model$cpo$cpo[
      seq_len(n_train)
    ]

    valid_cpo <- is.finite(cpo_train) &
      cpo_train > 0

    invalid_cpo <- sum(
      !valid_cpo
    )

    if (!any(valid_cpo)) {

      nlscpo_value <- NA_real_
      mean_nlscpo_value <- NA_real_

    } else {

      nlscpo_value <- -sum(
        log(cpo_train[valid_cpo])
      )

      mean_nlscpo_value <- -mean(
        log(cpo_train[valid_cpo])
      )
    }
  }

  model_criteria <- data.frame(
    Model = model_name,
    DIC = dic_value,
    WAIC = waic_value,
    NLSCPO = nlscpo_value,
    Mean_NLSCPO = mean_nlscpo_value,
    Invalid_CPO = invalid_cpo
  )

  # Return results and predictions
  list(
    predictive_metrics = predictive_metrics,
    model_criteria = model_criteria,

    observed_train = observed_train,
    predicted_train = predicted_train,

    observed_test = observed_test,
    predicted_test = predicted_test
  )
}
