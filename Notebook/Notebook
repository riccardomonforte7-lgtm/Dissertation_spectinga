# Standardise transmission descriptions and group them into broad categories

# Keep original transmission value
market_data_clean$transmission_original <- market_data_clean$transmission

# Clean transmission descriptions
transmission_clean <- as.character(market_data_clean$transmission)
transmission_clean <- gsub("<[^>]+>", "", transmission_clean)
transmission_clean <- stringi::stri_trans_general(transmission_clean, "Latin-ASCII")
transmission_clean <- tolower(transmission_clean)
transmission_clean <- gsub("[^[:alnum:]]+", " ", transmission_clean)
transmission_clean <- trimws(gsub("[[:space:]]+", " ", transmission_clean))

market_data_clean$transmission_clean <- transmission_clean


# Start with unclassified values
transmission_grouped <- rep("Other / unclassified", nrow(market_data_clean))

# Missing transmission information
transmission_grouped[is.na(transmission_clean)] <- "Not reported"

# Keep track of observations that have not yet been classified
unassigned <- !is.na(transmission_clean)

# Valtra "Direct" is interpreted as CVT
valtra_direct <- unassigned &
  !is.na(market_data_clean$make_detailed) &
  tolower(market_data_clean$make_detailed) == "valtra" &
  transmission_clean == "direct"

transmission_grouped[valtra_direct] <- "CVT / stepless"
unassigned[valtra_direct] <- FALSE


# CVT / stepless
idx <- unassigned & stringr::str_detect(
  transmission_clean,
  stringr::regex(cvt_pattern)
)

transmission_grouped[idx] <- "CVT / stepless"
unassigned[idx] <- FALSE


# Full powershift
idx <- unassigned & stringr::str_detect(
  transmission_clean,
  stringr::regex(full_powershift_pattern)
